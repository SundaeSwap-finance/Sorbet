{
  "manifest_version": 3,

  "name": "Sundae Sorbet",
  "description": "The Cardano Developer's Wallet",
  "version": "1.0",

  "options_ui": {
    "page": "options.html"
  },

  "action": {
    "default_icon": {
      "16": "sorbet.png"
    },
    "default_popup": "popup.html"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["js/sorbet_stub.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "css": ["styles.css"],
      "js": ["js/content_script.js"],
      "run_at": "document_start"
    }
  ],

  "devtools_page": "devtools.html",

  "web_accessible_resources": [
    {
      "resources": ["js/injectedScript.js", "js/*.js", "sorbet.png"],
      "matches": ["<all_urls>"]
    }
  ],

  "background": {
    "service_worker": "js/background.js"
  },

  "permissions": ["storage"],

  "host_permissions": ["<all_urls>"]

}
